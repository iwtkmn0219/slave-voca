# Google AI Studio에서 받은 Gemini API 키(서버에서만 쓴다)
GEMINI_API_KEY=

# 앱 주소(포트 포함). Google 로그인 콜백과 쿠키가 이 주소를 기준으로 한다.
BETTER_AUTH_URL=http://localhost:3000
# 세션 서명용 비밀값(32자 이상 무작위). 예: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google Cloud Console의 OAuth 클라이언트(웹 애플리케이션). README "Google 로그인 설정" 참고
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 바로 승인되는 관리자 이메일(쉼표로 여러 개). 나머지는 가입 후 관리자 승인이 필요하다.
ADMIN_EMAILS=

# 개발 전용 로그인(이메일만으로 들어가기). BETTER_AUTH_URL이 localhost·127.0.0.1일 때만 켜진다.
AUTH_DEV_LOGIN=
